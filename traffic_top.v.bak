module simple_alu (
  input 		    clk,
  input		 	    reset,
  input  	 [0:0]  enable,
  input  	 [1:0]	mode,
  input  	 [7:0]  a,
  input  	 [7:0]  b,
  output reg [31:0] c
);
  reg [31:0] c_temp;
  reg [2:0]  state;
  
  always@(posedge clk) begin
    if(reset) begin
      	state  <= 0;
      	c_temp <= 0;
    	c 	   <= 0;
    end
    else begin
      if(state == 0) begin
        if(enable == 1) begin
        	state <= 1;
        end
      end
      else if(state == 1) begin
        if(mode == 2'b00) begin
        	c_temp <= a + b;
        end
        else if(mode == 2'b01) begin
        	c_temp <= a - b;
        end
        else if(mode == 2'b10) begin
        	c_temp <= a * b;
        end
        else if(mode == 2'b11) begin
        	c_temp <= a / b;
        end
        state  <= 2;
      end
      else if(state == 2) begin
      	c <= c_temp;
        state <= 3;
      end
    end
  end
endmodule